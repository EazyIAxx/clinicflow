// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  recepcionista
  profissional
  gestor
}

enum UserStatus {
  ativo
  convite_pendente
}

model Clinic {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  cnpj           String?
  phone          String?
  address        String?
  hours          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  professionals  Professional[]
  appointments   Appointment[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  patients       Patient[]
  documents      Document[]
  leads          Lead[]
  leadInteractions LeadInteraction[]
  procedures     Procedure[]
  budgets        Budget[]
  charges        Charge[]
  expenses       Expense[]
}

/// id igual ao id do usuário em auth.users (Supabase) — atribuído no cadastro,
/// sem @default, pra não depender de trigger no Postgres pra manter em sincronia.
model User {
  id        String     @id @db.Uuid
  clinicId  String     @db.Uuid
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  email     String     @unique
  role      UserRole
  status    UserStatus @default(convite_pendente)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Proteção contra brute force no login: depois de 3 tentativas erradas,
  /// exige um código de verificação enviado por e-mail antes de aceitar
  /// novas tentativas de senha.
  failedLoginAttempts       Int       @default(0)
  verificationCodeHash      String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts      Int       @default(0)
}

enum AppointmentStatus {
  pendente
  confirmada
  remarcada
  cancelada
  bloqueio
}

enum AppointmentKind {
  consulta
  bloqueio
}

model Professional {
  id            String        @id @default(uuid()) @db.Uuid
  clinicId      String        @db.Uuid
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name          String
  specialty     String
  room          String
  /// Registro no conselho profissional (CRM, CRO, CREFITO, COREN etc.).
  /// Opcional porque nem toda especialidade tem conselho regulador.
  licenseNumber String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointments  Appointment[]
  patients      Patient[]
  leads         Lead[]
  budgets       Budget[]

  @@index([clinicId])
}

/// `date`/`rescheduledFromDate` guardados como texto "yyyy-MM-dd" (não como
/// DateTime) de propósito: é só uma chave de dia, sem componente de hora, e
/// isso evita qualquer conversão de fuso horário entre o servidor e o grid —
/// a mesma string que aparece na URL/grid é a que fica salva no banco.
model Appointment {
  id                  String            @id @default(uuid()) @db.Uuid
  clinicId            String            @db.Uuid
  clinic              Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professionalId      String            @db.Uuid
  professional        Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date                String
  startTime           String
  durationMinutes     Int
  status              AppointmentStatus
  kind                AppointmentKind
  patientName         String?
  service             String?
  reason              String?
  notes               String?
  rescheduledFromDate String?
  rescheduledFromTime String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([clinicId, date])
  @@index([professionalId, date])
}

enum StockCategory {
  medicamento
  material
  insumo
  equipamento
}

enum StockMovementType {
  entrada
  saida
}

model StockItem {
  id          String          @id @default(uuid()) @db.Uuid
  clinicId    String          @db.Uuid
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  category    StockCategory
  unit        String
  quantity    Int             @default(0)
  minQuantity Int             @default(0)
  batch       String?
  /// yyyy-MM-dd — mesmo padrão do Appointment.date, evita conversão de fuso.
  expiresAt   String?
  supplier    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]

  @@index([clinicId])
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  clinicId    String            @db.Uuid
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  itemId      String            @db.Uuid
  item        StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  date        String
  reason      String
  performedBy String
  createdAt   DateTime          @default(now())

  @@index([clinicId, date])
  @@index([itemId])
}

enum PatientStatus {
  ativo
  inativo
}

model Patient {
  id                         String        @id @default(uuid()) @db.Uuid
  clinicId                   String        @db.Uuid
  clinic                     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name                       String
  /// yyyy-MM-dd
  birthDate                  String
  phone                      String
  email                      String?
  cpf                        String?
  responsibleProfessionalId  String?       @db.Uuid
  responsibleProfessional    Professional? @relation(fields: [responsibleProfessionalId], references: [id], onDelete: SetNull)
  status                     PatientStatus @default(ativo)
  notes                      String?
  /// yyyy-MM-dd
  lastVisitAt                String?
  healthInsuranceProvider    String?
  healthInsurancePlan        String?
  healthInsuranceCardNumber  String?
  /// yyyy-MM-dd
  healthInsuranceValidUntil  String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  documents                  Document[]
  budgets                    Budget[]
  charges                    Charge[]

  @@index([clinicId])
  @@index([responsibleProfessionalId])
}

enum DocumentCategory {
  exame
  receita
  atestado
  documento
}

/// `exame` é restrito pra quem não é profissional/gestor (ver lib/document-access.ts
/// e a policy de RLS abaixo) — dado clínico sensível, diferente de receita/atestado.
model Document {
  id          String           @id @default(uuid()) @db.Uuid
  clinicId    String           @db.Uuid
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId   String           @db.Uuid
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  category    DocumentCategory
  /// Caminho no bucket do Supabase Storage: {clinicId}/{patientId}/{id}-{name}
  storagePath String
  fileType    String
  sizeBytes   Int
  uploadedBy  String
  createdAt   DateTime         @default(now())

  @@index([clinicId, patientId])
}

enum LeadOrigin {
  instagram
  indicacao
  google
  whatsapp
  site
  outro
}

enum LeadStage {
  novo
  em_conversa
  agendado
  convertido
  perdido
}

enum InteractionType {
  nota
  ligacao
  mensagem
}

model Lead {
  id                         String            @id @default(uuid()) @db.Uuid
  clinicId                   String            @db.Uuid
  clinic                     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name                       String
  phone                      String
  email                      String?
  origin                     LeadOrigin
  interest                   String
  responsibleProfessionalId  String?           @db.Uuid
  responsibleProfessional    Professional?     @relation(fields: [responsibleProfessionalId], references: [id], onDelete: SetNull)
  stage                      LeadStage         @default(novo)
  notes                      String?
  /// Preenchido quando o lead vira paciente de verdade (convertLeadToPatient).
  convertedPatientId         String?           @db.Uuid
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  interactions                LeadInteraction[]

  @@index([clinicId])
  @@index([responsibleProfessionalId])
}

model LeadInteraction {
  id        String           @id @default(uuid()) @db.Uuid
  clinicId  String           @db.Uuid
  clinic    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  leadId    String           @db.Uuid
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      InteractionType
  content   String
  /// yyyy-MM-dd
  date      String
  author    String
  createdAt DateTime         @default(now())

  @@index([clinicId, leadId])
}

model Procedure {
  id              String       @id @default(uuid()) @db.Uuid
  clinicId        String       @db.Uuid
  clinic          Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name            String
  category        String
  price           Decimal      @db.Decimal(10, 2)
  durationMinutes Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  budgetItems     BudgetItem[]

  @@index([clinicId])
}

enum BudgetStatus {
  rascunho
  enviado
  aprovado
  recusado
  expirado
}

model Budget {
  id                         String        @id @default(uuid()) @db.Uuid
  clinicId                   String        @db.Uuid
  clinic                     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId                  String        @db.Uuid
  patient                    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  responsibleProfessionalId  String?       @db.Uuid
  responsibleProfessional    Professional? @relation(fields: [responsibleProfessionalId], references: [id], onDelete: SetNull)
  discountPercent            Decimal       @default(0) @db.Decimal(5, 2)
  /// yyyy-MM-dd
  validUntil                 String
  status                     BudgetStatus  @default(rascunho)
  notes                      String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  items                      BudgetItem[]
  charges                    Charge[]

  @@index([clinicId])
  @@index([patientId])
}

model BudgetItem {
  id          String    @id @default(uuid()) @db.Uuid
  budgetId    String    @db.Uuid
  budget      Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  procedureId String    @db.Uuid
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  /// Valor do item no momento da criação do orçamento — pode divergir do
  /// preço atual da tabela de procedimentos.
  amount      Decimal   @db.Decimal(10, 2)

  @@index([budgetId])
}

enum ChargeSourceType {
  orcamento
  consulta
}

enum ChargeStatus {
  pendente
  pago
  cancelado
}

enum PaymentMethod {
  dinheiro
  cartao_credito
  cartao_debito
  pix
  boleto
}

model Charge {
  id            String           @id @default(uuid()) @db.Uuid
  clinicId      String           @db.Uuid
  clinic        Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String           @db.Uuid
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceType    ChargeSourceType
  budgetId      String?          @db.Uuid
  budget        Budget?          @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  description   String
  amount        Decimal          @db.Decimal(10, 2)
  /// yyyy-MM-dd
  dueDate       String
  status        ChargeStatus     @default(pendente)
  paymentMethod PaymentMethod?
  /// yyyy-MM-dd
  paidAt        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([budgetId])
}

enum ExpenseCategory {
  aluguel
  salarios
  fornecedores
  marketing
  utilidades
  outros
}

enum ExpenseStatus {
  pendente
  pago
}

enum ExpenseRecurrence {
  mensal
  anual
}

model Expense {
  id          String             @id @default(uuid()) @db.Uuid
  clinicId    String             @db.Uuid
  clinic      Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  description String
  category    ExpenseCategory
  amount      Decimal            @db.Decimal(10, 2)
  /// yyyy-MM-dd
  dueDate     String
  status      ExpenseStatus      @default(pendente)
  /// yyyy-MM-dd
  paidAt      String?
  isRecurring Boolean            @default(false)
  recurrence  ExpenseRecurrence?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([clinicId])
}
